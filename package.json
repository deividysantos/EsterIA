{
  "name": "painel-agentes",
  "version": "2.0.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "Painel e motor de esteira para orquestrar agentes de código (Claude, Cursor, Antigravity, Codex).",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "painel": "./bin/painel.mjs"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/cli/painel.ts servidor",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node bin/painel.mjs servidor",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "node --import tsx --test \"testes/**/*.test.ts\""
  },
  "dependencies": {
    "@hono/node-server": "2.1.11",
    "hono": "4.13.22",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tanstack/react-query": "5.108.4",
    "@types/node": "22.20.7",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
